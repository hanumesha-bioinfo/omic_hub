# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The URL of the Supabase project (server-only).
# SUPABASE_SERVICE_ROLE_KEY: The Supabase service-role key (server-only secret).
# These are intentionally NOT VITE_ prefixed so they are never exposed to the
# browser bundle. The server uses them to verify JWTs and read authoritative
# role data from the profiles table. Configure them via the Secrets panel.
SUPABASE_URL="MY_SUPABASE_URL"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# Razorpay configuration. The three server values are intentionally NOT
# VITE_ prefixed so they are never exposed to the browser bundle. Configure
# them via the Secrets panel. Point the Razorpay webhook at
# <APP_URL>/api/payments/webhook (POST); it verifies x-razorpay-signature
# against RAZORPAY_WEBHOOK_SECRET before granting any entitlement.
# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET: server-side Razorpay credentials.
# RAZORPAY_WEBHOOK_SECRET: secret used to sign webhook payloads server-side.
RAZORPAY_KEY_ID="MY_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="MY_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="MY_RAZORPAY_WEBHOOK_SECRET"

# VITE_RAZORPAY_KEY_ID: the public Razorpay key id. It is a non-secret value;
# the checkout key id is returned by the authenticated /api/payments/orders
# response (sourced from RAZORPAY_KEY_ID), so this variable is informational
# only and is not required for the current checkout flow.
VITE_RAZORPAY_KEY_ID="MY_RAZORPAY_KEY_ID"
