# OMIC HUB environment template
# Copy to .env.local and fill in real values. .env.local is git-ignored.
#
# IMPORTANT: server-side secrets must NOT use the VITE_ prefix. Only values
# that are safe to expose in the browser bundle may start with VITE_.

# ---------------------------------------------------------------------------
# Server configuration
# ---------------------------------------------------------------------------

# PORT: HTTP port the Express server listens on.
PORT=3000

# HOST: bind address. Use 0.0.0.0 in containers / hosting, 127.0.0.1 locally.
HOST=0.0.0.0

# PUBLIC_APP_URL: public origin used to build absolute links and certificate URLs.
# NOTE: the code reads PUBLIC_APP_URL — setting APP_URL has no effect.
PUBLIC_APP_URL=http://localhost:3000

# GEMINI_API_KEY: Google Gemini API key for AI features.
GEMINI_API_KEY=your_gemini_api_key

# SUPABASE_URL: Supabase project URL (server-side, verifies JWTs and reads roles).
SUPABASE_URL=https://your-project.supabase.co

# SUPABASE_SERVICE_ROLE_KEY: Supabase service-role key (server-side secret).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# CERTIFICATE_SIGNING_SECRET: HMAC secret for server-issued assessment certificates.
# Use a long random value; changing it invalidates previously issued certificates.
CERTIFICATE_SIGNING_SECRET=your_long_random_signing_secret

# Razorpay server credentials. Premium is granted ONLY by the signed webhook.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Point the webhook at POST <PUBLIC_APP_URL>/api/payments/webhook.

# ---------------------------------------------------------------------------
# Client configuration (safe to expose in the browser bundle)
# ---------------------------------------------------------------------------

# VITE_SUPABASE_URL: Supabase project URL (public).
VITE_SUPABASE_URL=https://your-project.supabase.co

# VITE_SUPABASE_PUBLISHABLE_KEY: Supabase publishable/anon key (public).
# VITE_SUPABASE_ANON_KEY is also accepted as a legacy alias.
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# VITE_API_BASE_URL: optional API base URL when the API is on another origin.
# Leave empty when the client and API are served from the same origin.
VITE_API_BASE_URL=
